-- TimeBomb Duels | Rayfield UI
local Rayfield = loadstring(game:HttpGet("https://sirius.menu/rayfield"))()

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local VirtualUser = game:GetService("VirtualUser")
local LP = Players.LocalPlayer

local KEYWORDS = {"bomb", "bomba", "fuse", "tnt"}

local F = {
    ESP = false,
    ESPAll = false,
    ESPColor = Color3.fromRGB(255, 60, 60),
    ESPNames = true,
    Hitbox = false,
    HitboxSize = 8,
    AutoPass = false,
    AutoFollow = false,
    Range = 45,
    PassRange = 12,
    AntiAfk = true,
}

local boxes, hl, tags = {}, {}, {}

local function hasBomb(plr)
    local ch = plr.Character
    if not ch or not ch:FindFirstChild("HumanoidRootPart") then return false end
    for _, d in ipairs(ch:GetDescendants()) do
        if d:IsA("Tool") then
            local n = string.lower(d.Name)
            for _, k in ipairs(KEYWORDS) do
                if string.find(n, k) then return true end
            end
        end
    end
    for _, a in ipairs({"HasBomb", "hasBomb", "Bomb", "CarryingBomb"}) do
        if plr:GetAttribute(a) or ch:GetAttribute(a) then return true end
    end
    return false
end

local function clearPlayer(plr)
    if boxes[plr] then boxes[plr]:Destroy(); boxes[plr] = nil end
    if hl[plr] then hl[plr]:Destroy(); hl[plr] = nil end
    if tags[plr] then tags[plr]:Destroy(); tags[plr] = nil end
end

local function addBox(plr)
    if plr == LP or boxes[plr] then return end
    local ch = plr.Character
    local root = ch and ch:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local b = Instance.new("Part")
    b.Name = "TB_Hitbox"
    b.Shape = Enum.PartType.Ball
    b.Size = Vector3.new(F.HitboxSize, F.HitboxSize, F.HitboxSize)
    b.Transparency = 1
    b.CanCollide = false
    b.Massless = true
    b.CFrame = root.CFrame * CFrame.new(0, 1, 0)
    b.Parent = ch
    local w = Instance.new("Weld")
    w.Part0, w.Part1, w.Parent = root, b, b
    boxes[plr] = b
end

local function nearest(range)
    local root = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local best, bestD
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LP and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local d = (hrp.Position - root.Position).Magnitude
                if d <= range and (not bestD or d < bestD) then best, bestD = p, d end
            end
        end
    end
    return best, bestD
end

local function firePrompts()
    local ch = LP.Character
    if not ch then return end
    for _, d in ipairs(ch:GetDescendants()) do
        if d:IsA("ProximityPrompt") and d.Enabled then
            if fireproximityprompt then
                pcall(fireproximityprompt, d)
            else
                pcall(function()
                    d:InputHoldBegin()
                    task.wait(d.HoldDuration)
                    d:InputHoldEnd()
                end)
            end
        end
    end
end

