Misc:CreateToggle({Name = "Anti-AFK", CurrentValue = true, Flag = "afk", Callback = function(v) F.AntiAfk = v end})

-- Loop principal
RunService.Heartbeat:Connect(function()
    for _, p in ipairs(Players:GetPlayers()) do
        if F.Hitbox then addBox(p) end

        local ch = p.Character
        local carrying = ch and hasBomb(p)
        local show = F.ESPAll or (F.ESP and carrying)

        if show and ch and p ~= LP then
            if not hl[p] or hl[p].Parent ~= ch then
                if hl[p] then hl[p]:Destroy() end
                local h = Instance.new("Highlight")
                h.FillColor = F.ESPColor
                h.OutlineColor = Color3.new(1, 1, 1)
                h.FillTransparency = 0.45
                h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                h.Parent = ch
                hl[p] = h
            else
                hl[p].FillColor = F.ESPColor
            end

            if F.ESPNames and ch:FindFirstChild("Head") then
                if not tags[p] or tags[p].Adornee ~= ch:FindFirstChild("Head") then
                    if tags[p] then tags[p]:Destroy() end
                    local bb = Instance.new("BillboardGui")
                    bb.Size = UDim2.fromScale(4, 0.8)
                    bb.StudsOffset = Vector3.new(0, 2.6, 0)
                    bb.AlwaysOnTop = true
                    bb.Adornee = ch:FindFirstChild("Head")
                    bb.Parent = ch:FindFirstChild("Head")
                    local tl = Instance.new("TextLabel")
                    tl.Size = UDim2.fromScale(1, 1)
                    tl.BackgroundTransparency = 1
                    tl.Text = p.Name
                    tl.TextColor3 = F.ESPColor
                    tl.TextStrokeTransparency = 0.3
                    tl.TextScaled = true
                    tl.Font = Enum.Font.GothamBold
                    tl.Parent = bb
                    tags[p] = bb
                else
                    local tl = tags[p]:FindFirstChildOfClass("TextLabel")
                    if tl then tl.TextColor3 = F.ESPColor end
                end
            elseif tags[p] then
                tags[p]:Destroy(); tags[p] = nil
            end
        else
            clearPlayer(p)
        end
    end

    if hasBomb(LP) then
        local target, dist = nearest(F.Range)
        if target and target.Character then
            local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
            if F.AutoFollow and hum and dist > 4 then
                hum:MoveTo(target.Character.HumanoidRootPart.Position)
            end
            if F.AutoPass and dist <= F.PassRange then
                firePrompts()
            end
        end
    end
end)

